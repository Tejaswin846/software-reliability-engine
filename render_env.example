# Render environment variables for Software

SOFTWARE_ENV=production

# Render supplies PORT automatically. Do not hard-code it.
# PORT=10000

# Required. Software also supports SOFTWARE_JWT_SECRET, but JWT_SECRET is Render-friendly.
JWT_SECRET=replace-with-a-long-random-secret

# Required permanent Render public URL.
PUBLIC_BASE_URL=https://software-reliability-engine.onrender.com

# Use the same permanent Render URL when dashboard and API are served together.
SOFTWARE_ALLOWED_ORIGINS=https://software-reliability-engine.onrender.com

# Optional bootstrap SDK key list for initial SDK tests.
# Production users should create project API keys from the dashboard.
SOFTWARE_SDK_API_KEYS=sw_replace_with_initial_render_sdk_key
SOFTWARE_ENABLE_BOOTSTRAP_DEV_KEY=true

# SQLite paths. Use these with the Render persistent disk mounted at /var/data.
SOFTWARE_API_DB_PATH=/var/data/software_reliability.db
RELIABILITY_DB_PATH=/var/data/reliability.db

# Stripe billing. Leave blank until Stripe is configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_SUCCESS_URL=https://software-reliability-engine.onrender.com/dashboard?checkout=success
STRIPE_CANCEL_URL=https://software-reliability-engine.onrender.com/pricing?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=https://software-reliability-engine.onrender.com/dashboard?billing=portal

# Optional custom domain settings once Render custom domains are added.
SOFTWARE_PRIMARY_HOST=
SOFTWARE_PRODUCTION_HOSTS=
SOFTWARE_REDIRECT_HOSTS=
SOFTWARE_FORCE_HTTPS=true
SOFTWARE_REDIRECT_WWW=true

# Optional Supabase persistence for chats, messages, and benchmark mirrors.
# Run supabase_schema.sql in the Supabase SQL editor before setting these.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Microsoft Clarity browser analytics.
CLARITY_PROJECT_ID=xc0zbrjy3z

# Qdrant Cloud long-term chat memory.
QDRANT_URL=https://your-cluster.region.cloud.qdrant.io
QDRANT_API_KEY=replace-with-your-qdrant-api-key

# Sentry production monitoring. Keep the DSN in Render's secret environment settings.
SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENABLE_LOGS=true
SENTRY_ENVIRONMENT=production
# Optional. Render's RENDER_GIT_COMMIT is used automatically when this is empty.
SENTRY_RELEASE=

# Composio connected application tools for authenticated users.
COMPOSIO_API_KEY=replace-with-your-composio-api-key
INTEGRATION_ENCRYPTION_KEY=replace-with-a-long-random-secret
INTEGRATION_STATE_SECRET=replace-with-a-long-random-secret

# Upstash Redis for ephemeral caching, sessions, queues, rate limits, and locks.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
SOFTWARE_REDIS_KEY_PREFIX=software
SOFTWARE_AI_CACHE_TTL_SECONDS=3600
SOFTWARE_CONVERSATION_STATE_TTL_SECONDS=21600
SOFTWARE_SESSION_CACHE_TTL_SECONDS=3600
SOFTWARE_AI_EXECUTION_STATE_TTL_SECONDS=1800
SOFTWARE_REDIS_QUEUE_MAX_LENGTH=10000
SOFTWARE_REDIS_RETRIES=2
SOFTWARE_REDIS_RETRY_INTERVAL_SECONDS=0.25
SOFTWARE_API_RATE_LIMIT_REQUESTS=300
SOFTWARE_API_RATE_LIMIT_WINDOW_SECONDS=60
